---
import { travelers } from '../data/site';
---

<section id="para-quien" class="travelers" aria-labelledby="travelers-title">
	<div class="container">
		<div class="section-head">
			<h2 id="travelers-title" class="display section-head__title">Viaja como<br />tú viajas</h2>
			<p class="lead section-head__text">
				Sin itinerarios genéricos. La sorpresa se ajusta a quién va contigo y al ritmo que quieres.
			</p>
		</div>

		<ul class="tags">
			{
				travelers.map((traveler) => (
					<li class={`tag tag--${traveler.tone}`}>
						<div class="tag__top">
							<span class="tag__hole" aria-hidden="true" />
							<span class="tag__pax">{traveler.pax}</span>
						</div>
						<h3 class="tag__title">{traveler.title}</h3>
						<p class="tag__text">{traveler.text}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.travelers {
		padding-block: clamp(8px, 3vw, 40px) clamp(64px, 10vw, 140px);
	}

	.tags {
		margin-top: clamp(28px, 5vw, 72px);
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 24px;
		align-items: start;
	}

	.tag {
		--hole-ring: #c9cdd3;
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 30px 28px 34px;
		border-radius: 16px;
		transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.tag:nth-child(1) {
		transform: rotate(-3deg);
		margin-top: 20px;
	}

	.tag:nth-child(2) {
		transform: rotate(2deg);
	}

	.tag:nth-child(3) {
		transform: rotate(-1.5deg);
		margin-top: 36px;
	}

	.tag:nth-child(4) {
		transform: rotate(3deg);
		margin-top: 8px;
	}

	.tag:hover {
		transform: rotate(0deg) translateY(-6px);
	}

	.tag--light {
		background: var(--light-bg);
		color: var(--ink);
	}

	.tag--yellow {
		--hole-ring: #e0bc00;
		background: var(--primary);
		color: var(--ink);
	}

	.tag--dark {
		--hole-ring: var(--ink-muted);
		background: var(--surface);
		border: 1px solid var(--line-strong);
	}

	.tag__top {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.tag__hole {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: var(--bg);
		box-shadow: inset 0 0 0 5px var(--hole-ring);
	}

	.tag__pax {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		opacity: 0.7;
	}

	.tag__title {
		margin-top: 30px;
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(2.25rem, 1.2rem + 2.6vw, 4rem);
		line-height: 0.9;
		text-transform: uppercase;
	}

	.tag--dark .tag__title {
		color: var(--primary);
	}

	.tag__text {
		font-size: 1.0625rem;
		line-height: 1.45;
		opacity: 0.8;
	}

	.tag--dark .tag__text {
		color: var(--muted);
		opacity: 1;
	}

	@media (max-width: 1024px) {
		.tags {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 12px;
		}

		.tag:nth-child(n) {
			margin-top: 0;
		}
	}

	@media (max-width: 720px) {
		.tag {
			gap: 8px;
			padding: 18px 16px 20px;
			border-radius: 14px;
		}

		.tag__hole {
			width: 16px;
			height: 16px;
			box-shadow: inset 0 0 0 4px var(--hole-ring);
		}

		.tag__pax {
			display: none;
		}

		.tag__title {
			margin-top: 16px;
		}

		.tag__text {
			font-size: 0.875rem;
			line-height: 1.4;
		}
	}
</style>
