---
const items = ['Transporte', 'Alojamiento', 'Planes locales', 'Un solo pago', 'Cero estrés'];
// Two identical tracks make the marquee loop seamless.
const tracks = [0, 1];
---

<div class="ticker" role="marquee" aria-label={items.join(', ')}>
	<div class="ticker__rail">
		{
			tracks.map((track) => (
				<ul class="ticker__track" aria-hidden="true">
					{items.map((item) => (
						<li>
							<span>{item}</span>
							<svg width="22" height="22" viewBox="0 0 24 24">
								<path d="M12 2l2.4 7.6H22l-6.2 4.6 2.4 7.6L12 17.2l-6.2 4.6 2.4-7.6L2 9.6h7.6z" fill="currentColor" />
							</svg>
						</li>
					))}
				</ul>
			))
		}
	</div>
</div>

<style>
	.ticker {
		margin-inline: -40px;
		padding-block: 20px;
		background: var(--primary);
		color: var(--ink);
		transform: rotate(-1.6deg);
		overflow: hidden;
	}

	.ticker__rail {
		display: flex;
		width: max-content;
		animation: marquee 32s linear infinite;
	}

	.ticker__track {
		display: flex;
		align-items: center;
		gap: 40px;
		padding-right: 40px;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(1.375rem, 1rem + 1.4vw, 2.125rem);
		text-transform: uppercase;
		white-space: nowrap;
	}

	.ticker__track li {
		display: flex;
		align-items: center;
		gap: 40px;
	}

	@keyframes marquee {
		to {
			transform: translateX(-50%);
		}
	}

	@media (max-width: 720px) {
		.ticker {
			margin-inline: -20px;
			padding-block: 12px;
			transform: rotate(-2deg);
		}

		.ticker__track,
		.ticker__track li {
			gap: 18px;
		}

		.ticker__track {
			padding-right: 18px;
		}

		.ticker svg {
			width: 14px;
			height: 14px;
		}
	}
</style>
