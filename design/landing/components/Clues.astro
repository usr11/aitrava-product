---
import { clueTopics } from '../data/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
---

<section id="pistas" class="clues" aria-labelledby="clues-title">
	<div class="container clues__inner">
		<div class="clues__copy">
			<p class="eyebrow clues__eyebrow">La espera también es viaje</p>
			<h2 id="clues-title" class="display clues__title">Pistas antes<br />de despegar</h2>
			<p class="lead clues__text">
				Cada día se desbloquea una pista nueva. Arma teorías con quien viajas, apuesta por un destino y descubre si
				acertaste el día de la revelación.
			</p>
			<ul class="clues__topics" aria-label="Tipos de pistas">
				{clueTopics.map((topic) => <li>{topic}</li>)}
			</ul>
		</div>

		<div class="phone-wrap">
			<span class="phone-wrap__orbit" aria-hidden="true"></span>
			<div class="phone" role="img" aria-label="Vista de la app: cuenta regresiva para la revelación y pistas desbloqueadas">
				<div class="phone__screen" aria-hidden="true">
					<div class="phone__top">
						<span class="phone__heading">Mi sorpresa</span>
						<Logo size={32} showName={false} />
					</div>

					<div class="card card--countdown">
						<span class="card__label">Revelación en</span>
						<div class="countdown">
							<strong>03</strong><span>días</span>
							<strong>14</strong><span>h</span>
						</div>
						<div class="progress">
							{[1, 2, 3, 4, 5].map((n) => <span class:list={{ 'is-done': n <= 3 }} />)}
						</div>
					</div>

					<div class="card card--new">
						<span class="card__label">Pista 3 · Nueva</span>
						<p>Allá se cena tarde. Muy tarde. Guarda energía.</p>
					</div>

					<div class="card">
						<span class="card__label">Pista 2</span>
						<p class="card__soft">Empaca bloqueador y algo para la noche.</p>
					</div>

					<div class="card card--locked">
						<span class="card__label">Pista 4 · Mañana</span>
						<Icon name="locked" size={18} strokeWidth={1.8} />
					</div>

					<div class="phone__guess">
						<span>¿Ya sabes a dónde vas?</span>
						<strong>Adivinar</strong>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.clues__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 460px;
		gap: 80px;
		align-items: center;
		padding-block: clamp(72px, 10vw, 140px);
	}

	.clues__copy {
		display: flex;
		flex-direction: column;
		gap: 30px;
	}

	.clues__eyebrow {
		color: var(--secondary);
	}

	.clues__title {
		font-size: clamp(3.75rem, 8.4vw, 7.5rem);
		line-height: 0.86;
	}

	.clues__text {
		max-width: 540px;
		color: var(--muted);
	}

	.clues__topics {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 8px;
	}

	.clues__topics li {
		padding: 10px 18px;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-pill);
		color: var(--text-soft);
	}

	.phone-wrap {
		position: relative;
		display: flex;
		justify-content: center;
	}

	.phone-wrap__orbit {
		position: absolute;
		top: 110px;
		width: 420px;
		aspect-ratio: 1;
		border: 1px dashed var(--line-strong);
		border-radius: 50%;
	}

	.phone {
		position: relative;
		width: 360px;
		height: 740px;
		padding: 12px;
		background: #0f1114;
		border-radius: 52px;
		box-shadow:
			0 0 0 1px #33373e,
			0 50px 90px -30px rgb(0 0 0 / 0.8);
		transform: rotate(3deg);
	}

	.phone__screen {
		height: 100%;
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 56px 22px 22px;
		background: var(--bg);
		border-radius: 42px;
		overflow: hidden;
	}

	.phone__top {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.phone__heading {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.5rem;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 16px 18px;
		background: var(--surface);
		border-radius: 18px;
	}

	.card__label {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted-2);
	}

	.card__soft {
		color: var(--text-soft);
		line-height: 1.35;
	}

	.card--countdown {
		gap: 8px;
		padding: 18px;
	}

	.countdown {
		display: flex;
		align-items: baseline;
		gap: 10px;
		font-family: var(--font-display);
		font-weight: 800;
		text-transform: uppercase;
	}

	.countdown strong {
		font-size: 3rem;
		line-height: 1;
		color: var(--primary);
	}

	.countdown span {
		color: var(--muted-2);
	}

	.progress {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 5px;
		margin-top: 4px;
	}

	.progress span {
		height: 5px;
		border-radius: 9px;
		background: var(--line-strong);
	}

	.progress .is-done {
		background: var(--primary);
	}

	.card--new {
		padding: 18px;
		background: var(--primary);
		color: var(--ink);
	}

	.card--new .card__label {
		color: var(--ink);
		font-weight: 600;
	}

	.card--new p {
		font-size: 1.1875rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.card--locked {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		opacity: 0.6;
		color: var(--muted-2);
	}

	.phone__guess {
		margin-top: auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 16px;
		border: 1px dashed var(--ink-muted);
		border-radius: 16px;
		color: var(--muted-2);
	}

	.phone__guess strong {
		color: var(--primary);
		font-size: 0.9375rem;
	}

	@media (max-width: 1100px) {
		.clues__inner {
			grid-template-columns: minmax(0, 1fr);
			gap: 56px;
		}
	}

	@media (max-width: 720px) {
		.clues__topics {
			gap: 10px;
		}

		.clues__topics li {
			padding: 8px 14px;
			font-size: 0.9375rem;
		}

		.phone-wrap__orbit {
			display: none;
		}

		.phone {
			width: min(100%, 340px);
			height: auto;
			transform: rotate(-1.5deg);
		}

		.phone__screen {
			padding-top: 40px;
		}

		.phone__guess {
			margin-top: 6px;
		}
	}
</style>
