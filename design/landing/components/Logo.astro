---
import { Image } from 'astro:assets';
import mark from '../assets/aitrava-mark.jpg';

interface Props {
	size?: number;
	showName?: boolean;
	class?: string;
}

const { size = 40, showName = true, class: className } = Astro.props;
---

<span class:list={['logo', className]} style={`--logo-size: ${size}px`}>
	<Image src={mark} alt={showName ? '' : 'AiTrava'} width={size * 2} height={size * 2} class="logo__mark" />
	{showName && <span class="logo__name">AiTrava</span>}
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 12px;
	}

	.logo__mark {
		width: var(--logo-size);
		height: var(--logo-size);
		border-radius: calc(var(--logo-size) * 0.25);
	}

	.logo__name {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: calc(var(--logo-size) * 0.7);
		letter-spacing: 0.02em;
		line-height: 1;
	}
</style>
