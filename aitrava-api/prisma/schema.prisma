// AiTrava v4 · "Ve solo, sal acompañado". Modelo en docs/ROADMAP.md (sección 8, paso 78).
// Fechas en UTC; la app las muestra en America/Bogota.
// Dinero en pesos colombianos (enteros). AiTrava no recauda: el viajero le paga al anfitrión.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PlaceLine {
  URBANO // Línea 1 · dentro de Cali
  NATURALEZA // Línea 2 · ≤ 1 h de Cali
  ESCAPADA // Línea 3 · escapada de un día
}

enum PlaceStatus {
  active
  verify // pendiente de verificar accesos, seguridad o tarifas
  excluded
}

enum HostStatus {
  prospect // por contactar
  contacted
  interested
  accepted // aceptó por escrito la comisión
  declined
  active // ya operó al menos una salida
}

enum SalidaStatus {
  draft
  open
  closed // no recibe más reservas
  done
  cancelled
}

enum ReservationStatus {
  requested // apartó el cupo y aceptó precio y condiciones (escalera nivel 4)
  confirmed // el equipo confirmó el cupo y envió los datos de pago
  payment_reported // el viajero dice que pagó (pago iniciado, nivel 5 sin verificar)
  paid // el equipo vio el comprobante (nivel 5 verificado)
  attended
  no_show
  cancelled
  expired // venció el apartado sin pago
}

/// Equipo de AiTrava (los viajeros no crean cuenta).
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  firstName       String
  lastName        String
  passwordHash    String
  role            Role      @default(USER)
  emailVerifiedAt DateTime?
  verifyTokenHash String?
  verifySentAt    DateTime?
  resetTokenHash  String?
  resetExpiresAt  DateTime?
  termsAcceptedAt DateTime
  dataConsentAt   DateTime
  isDemo          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// Catálogo de lugares (documento §3). Los precios son de referencia y estimados.
model Place {
  id         String      @id @default(cuid())
  slug       String      @unique
  line       PlaceLine
  name       String
  area       String // zona o municipio
  experience String
  duration   String
  distance   String? // desde Cali
  refPrice   Int // precio de referencia por persona (estimado)
  note       String?
  status     PlaceStatus @default(active)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  salidas    Salida[]
}

/// Anfitrión o guía local (lado oferta, TC1-A).
model Host {
  id                 String     @id @default(cuid())
  name               String
  phone              String?
  email              String?
  organization       String?
  activity           String
  area               String?
  rnt                String? // Registro Nacional de Turismo
  status             HostStatus @default(prospect)
  commissionAccepted Float? // p. ej. 0.20 si aceptó el 20 %
  acceptedAt         DateTime?
  isTestHost         Boolean    @default(false) // anfitrión de prueba: no suma a la meta 3/15
  source             String     @default("admin") // admin | form
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  salidas            Salida[]

  @@index([status])
}

model Salida {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  placeId              String
  place                Place         @relation(fields: [placeId], references: [id], onDelete: Restrict)
  hostId               String?
  host                 Host?         @relation(fields: [hostId], references: [id], onDelete: SetNull)
  title                String
  summary              String
  startsAt             DateTime
  durationMin          Int
  meetingPoint         String
  capacity             Int
  minToRun             Int           @default(5) // si no se llega, se cancela y se devuelve el 100 %
  price                Int // por persona, se le paga al anfitrión
  serviceFee           Int           @default(0) // cargo opcional al viajero (palanca del modelo)
  commissionRate       Float         @default(0.2)
  includes             String[]
  womenOnly            Boolean       @default(false)
  paymentInstructions  String? // datos de pago del anfitrión: solo se muestran con el cupo confirmado
  status               SalidaStatus  @default(draft)
  isSimulacro          Boolean       @default(false) // prueba del PMV: no cuenta como venta
  isDemo               Boolean       @default(false)
  hostNewClients       Int? // clientes nuevos que el anfitrión confirma en la entrevista
  coordinatorHours     Float? // horas reales del equipo (para el modelo)
  commissionPaidAt     DateTime?
  commissionPaidAmount Int?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  reservations         Reservation[]
  costs                AdminCost[]

  @@index([status, startsAt])
}

model Reservation {
  id                 String            @id @default(cuid())
  number             Int               @unique @default(autoincrement()) // AITRAVA-C01, C02…
  tokenHash          String            @unique
  surveyTokenHash    String?           @unique // enlace de la encuesta que envía el equipo
  salidaId           String
  salida             Salida            @relation(fields: [salidaId], references: [id], onDelete: Restrict)
  name               String
  phone              String // normalizado: 57XXXXXXXXXX
  email              String?
  isAdult            Boolean // V1
  inCali             Boolean // V2
  knowsTeam          Boolean // V3 (true = amigo o familia del equipo: no cuenta)
  heardFrom          String // GRP | IG | REF | ALI | OTRO (lo que responde)
  channel            String? // de la URL (?c= o utm_source)
  variant            String? // A | B
  motivation         String // pregunta filtro (V5)
  intentValid        Boolean? // V5: lo marca el equipo
  comesAlone         Boolean
  phoneChallenge     Boolean           @default(false) // aceptó el reto del celular sellado
  challengeCompleted Boolean?
  price              Int
  serviceFee         Int               @default(0)
  status             ReservationStatus @default(requested)
  holdUntil          DateTime
  acceptedAt         DateTime // aceptó precio, fecha, reembolso, conducta y consentimiento
  confirmedAt        DateTime?
  paymentReportedAt  DateTime?
  paymentNote        String?
  paidAt             DateTime?
  attendedAt         DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  refundNote         String?
  adminNotes         String?
  anonId             String?
  isDemo             Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  survey             SurveyResponse?

  @@index([salidaId, status])
  @@index([phone])
  @@index([status, holdUntil])
}

/// Encuesta de cierre (documento §4.4). Una por asistente.
model SurveyResponse {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  cameAlone     Boolean
  newContact    Boolean
  nps           Int
  wouldReturn   Boolean
  returnPlace   String?
  improve       String?
  createdAt     DateTime    @default(now())
}

/// Lista de espera (TC0: interés, nivel 2 de la escalera).
model WaitlistEntry {
  id         String     @id @default(cuid())
  name       String
  phone      String     @unique
  line       PlaceLine?
  motivation String?
  variant    String?
  channel    String?
  anonId     String?
  consentAt  DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

/// Costos reales: pauta por canal (CAC), kit, horas, fijos, formalización…
model AdminCost {
  id          String   @id @default(cuid())
  category    String // pauta | kit | horas | fijos | formalizacion | otros
  kind        String // fijo | variable
  channel     String? // para pauta: IG | GRP | …
  salidaId    String?
  salida      Salida?  @relation(fields: [salidaId], references: [id], onDelete: SetNull)
  amount      Int
  description String?
  date        DateTime
  createdAt   DateTime @default(now())

  @@index([date])
}

model Event {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  anonId    String?
  salidaId  String?
  variant   String?
  channel   String?
  props     Json?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([anonId])
}

/// Registro de ajustes (nivel 5): qué dato lo provocó, qué se cambió y qué pasó.
model Iteration {
  id         String   @id @default(cuid())
  version    String
  date       DateTime
  hypothesis String
  metric     String
  result     String
  decision   String
  change     String
  createdAt  DateTime @default(now())
}
