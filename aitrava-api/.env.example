# ── Base ─────────────────────────────────────────────
DATABASE_URL="postgresql://aitrava:aitrava@localhost:5432/aitrava"
# En producción, mínimo 32 caracteres (openssl rand -hex 32) o el API no arranca.
JWT_SECRET="cambia-esto-por-un-texto-largo-y-secreto"
PORT=4000
# URL de la app (CORS y enlaces de correos y encuestas). Se aceptan varias separadas por coma.
APP_URL="http://localhost:3000"

# ── Equipo ───────────────────────────────────────────
# Únicos correos que pueden crear cuenta (los viajeros no tienen cuenta). Reciben rol admin al verificar.
ADMIN_EMAILS=""
# Admin de respaldo creado por el seed. En producción solo se crea si defines ADMIN_PASSWORD.
ADMIN_EMAIL="admin@aitrava.co"
ADMIN_PASSWORD=""

# ── Correo (verificación y recuperación de las cuentas del equipo) ──
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="AiTrava <aitrava.25@gmail.com>"

# ── Negocio ──────────────────────────────────────────
# Comisión por defecto de una salida nueva (se pide 20 %, piso 16 %). Se ajusta por salida en /admin.
COMMISSION_RATE="0.20"
# Horas que se aparta un cupo mientras el viajero paga.
HOLD_HOURS="48"
# true = el seed crea la salida DEMO también en producción (para presentar). No cuenta en métricas.
SEED_DEMO="false"

# ── Pruebas e2e (opcional) ───────────────────────────
# Debe terminar en _test. Cada corrida usa un esquema efímero y lo borra al final.
TEST_DATABASE_URL="postgresql://aitrava:aitrava@localhost:5432/aitrava_test"
